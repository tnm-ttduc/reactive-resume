{
	"name": "tnm-hr-platform",
	"description": "TNM HR Platform helps users create, manage, and share professional resumes.",
	"version": "5.2.4",
	"private": true,
	"license": "MIT",
	"packageManager": "pnpm@11.10.0",
	"engines": {
		"node": ">=24 <25",
		"pnpm": ">=11.10.0 <12"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.14.0",
			"onFail": "download"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "11.10.0",
			"onFail": "download"
		}
	},
	"volta": {
		"node": "24.14.0",
		"pnpm": "11.10.0"
	},
	"workspaces": [
		"apps/*",
		"packages/*",
		"tooling"
	],
	"scripts": {
		"build": "turbo run build",
		"doctor": "turbo run doctor",
		"check": "biome check --write --unsafe . && markdownlint-cli2 --fix && github-actionlint -shellcheck= -pyflakes=",
		"db:generate": "turbo run db:generate --filter=@reactive-resume/db",
		"db:migrate": "turbo run db:migrate --filter=@reactive-resume/db",
		"db:studio": "turbo run db:studio --filter=@reactive-resume/db",
		"deploy:dokploy": "node scripts/deployment/deploy-dokploy.mjs",
		"lingui:extract": "turbo run lingui:extract --filter=web",
		"dev": "dotenvx run -f .env.local -- turbo run dev",
		"dev:web": "dotenvx run -f .env.local -- turbo run dev --filter=web",
		"knip": "knip",
		"start": "node apps/server/dist/index.mjs",
		"sprint0:render-golden": "pnpm --filter @reactive-resume/tooling sprint0:render-golden",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"test:coverage": "turbo run test:coverage",
		"test:ci": "turbo run test:ci",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:ci": "playwright test",
		"test:agent": "turbo run test:agent"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.3",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@dotenvx/dotenvx": "^1.75.1",
		"@playwright/test": "^1.61.1",
		"@reactive-resume/config": "workspace:*",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^26.1.1",
		"@types/pg": "^8.20.0",
		"@vitest/coverage-v8": "^4.1.10",
		"github-actionlint": "1.7.12",
		"happy-dom": "^20.10.6",
		"knip": "^6.25.0",
		"lefthook": "^2.1.10",
		"markdownlint-cli2": "0.23.0",
		"pg": "^8.22.0",
		"turbo": "^2.10.4",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
